# Shell/Python entrypoints must retain LF shebangs across Windows clones.
.gitattributes text eol=lf
SHA256SUMS text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=lf

# Overlay sources are hash-verified against pinned git blob SHAs; keep LF so
# bootstrap blob checks stay stable across Windows checkouts.
scripts/upstream_overlay/*.c text eol=lf
scripts/upstream_overlay/*.h text eol=lf

# Build metadata and documentation use stable text normalization.
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.env text eol=lf

# Preserve the vendor legal text byte-for-byte; its pinned SHA-256 is also
# verified by the runtime packager. Vendor formatting intentionally includes
# trailing spaces, so do not apply source whitespace diagnostics to it.
licenses/NVIDIA-CUDA-13.2-EULA.txt -text -whitespace
