# Generated build trees and CMake dependency caches.
/build*/
**/build*/
/_deps/
**/_deps/

# Downloaded upstream/model dependencies are prepared by bootstrap/download
# helpers and are intentionally not part of the source repository.
/third_party/

# Runtime media, traces, logs, and local validation output.
/outputs/
**/outputs/
*.log
*.trace
*.dmp
*.h3c
*.h3c.*
h3cspeed-keyframe-*/
h3-profile-*.json

# Local model/checkpoint payloads. The quantized-model preparer may create
# hardlinks, so an accidentally repo-local output root must remain untracked.
*.safetensors
*.onnx
*.npy
*.npz
*.gguf
*.ggml
*.pt
*.pth
*.ckpt
*.bf16

# Native/compiler products (including Windows debug symbols).
*.a
*.bin
*.d
*.dll
*.dylib
*.exe
*.exp
*.gch
*.ilk
*.lib
*.map
*.o
*.obj
*.pch
*.pdb
*.so
*.wasm

# Python/tool caches and local credentials.
__pycache__/
**/__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
**/.cache/
*.pyc
*.pyo
.env
.env.*
!.env.example
*.pem
*.secret
*.token
*.key
.npmrc
.netrc
credentials.json
token.json
hf_token*
huggingface_token*
id_rsa
id_ed25519
*.p12
*.pfx

# Archives/checksums created by scripts/package.py.
/dist/
*.zip
*.zip.sha256
*.tar.gz
*.tar.gz.sha256
