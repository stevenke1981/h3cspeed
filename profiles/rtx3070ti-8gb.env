# h3cspeed v0.2.0 — RTX 3070 Ti 8 GiB / system-RAM offload profile
H3_CUDA_LOW_VRAM=1
H3_CUDA_OFFLOAD=ram+file
H3_CUDA_VRAM_BUDGET_MIB=5888
H3_CUDA_WEIGHT_CACHE_MIB=1536
# Automatic host cache: all currently available RAM minus 2 GiB, capped at 64 GiB.
H3_CUDA_PINNED_HOST_MIB=128
H3_CUDA_STAGING_MIB=64
H3_CUDA_RELEASE_SCRATCH=1
H3_PROFILE=1
