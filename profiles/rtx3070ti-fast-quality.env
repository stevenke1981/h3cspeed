# h3cspeed fast-quality preset — RTX 3070 Ti 8 GiB
#
# The preset requests 864x480 (480p), five seconds; H3 aligns this to
# 124 frames (about 5.17 seconds). It uses a 288x160 internal render canvas,
# 20 steps, all 50 DiT layers, --reuse=1 and --core-reuse=4.
# The internal canvas is deliberately smaller so this quality path fits an
# 8 GiB RTX 3070 Ti; passing both reuse modes above one is rejected by runtime.
H3_CUDA_LOW_VRAM=1
H3_CUDA_OFFLOAD=ram+file
H3_CUDA_VRAM_BUDGET_MIB=5888
H3_CUDA_WEIGHT_CACHE_MIB=1536
H3_CUDA_PINNED_HOST_MIB=128
H3_CUDA_STAGING_MIB=64
H3_CUDA_RELEASE_SCRATCH=1
H3_PROFILE=1

# Optional explicit model/prompt/output overrides for the preset script:
# H3_FAST_QUALITY_MODEL_DIR=/path/to/MiniMax-H3
# H3_FAST_QUALITY_PROMPT='A red fox in snow.'
# H3_FAST_QUALITY_OUTPUT=/path/to/output.mp4

# A larger host cache can reduce unrelated file-backed weight evictions, but it
# cannot prevent SSD stream-slot rereads: SSD streaming intentionally retains a
# bounded active layer window and rereads the next slot on each denoising pass.
